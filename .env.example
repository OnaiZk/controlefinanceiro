# Copie para .env.local somente para configuração manual; prefira pnpm setup.
# Nenhuma senha em texto puro. Todos os segredos ficam somente no servidor.
DATABASE_MODE=local
SEED_DEMO_DATA=false
APP_ORIGIN=http://localhost:3000
# Somente teste na LAN, lista exata separada por vírgula. Nunca aplicada em produção.
DEV_ALLOWED_ORIGINS=
CONVEX_URL=https://SEU-PROJETO.convex.cloud
CONVEX_DEPLOY_KEY=
BACKEND_BRIDGE_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=
CAS_EMAIL=
CAS_PASSWORD_HASH=
KET_EMAIL=
KET_PASSWORD_HASH=
PLUGGY_API_URL=https://api.pluggy.ai
PRIVACY_MODE=local
NEXT_TELEMETRY_DISABLED=1
# Produção Netlify: DATABASE_MODE=convex e SEED_DEMO_DATA=false.
# APP_ORIGIN deve ser a origem HTTPS exata do site, sem barra no final.
# Gere chaves JWT_SECRET e ENCRYPTION_KEY com 32 bytes aleatórios (64 hex).
# BACKEND_BRIDGE_SECRET deve ser o mesmo no Netlify e no Convex.
# CONVEX_DEPLOY_KEY serve somente ao CLI/CI, nunca ao navegador ou Expo.
