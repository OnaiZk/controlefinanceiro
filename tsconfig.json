{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": false,
    "paths": {
      "@finance/shared": ["./packages/shared/src/index.ts"],
      "@finance/api/*": ["./apps/api/src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "apps/api/**/*.ts",
    "packages/**/*.ts",
    "convex/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "apps/web/.next", "apps/mobile"]
}
