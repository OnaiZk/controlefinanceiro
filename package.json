{
  "name": "entre-contas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7.0 <25"
  },
  "packageManager": "pnpm@10.30.0",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "node scripts/web.mjs dev",
    "build": "node scripts/web.mjs build",
    "start": "node scripts/web.mjs start",
    "lint": "eslint apps packages convex tests scripts --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit --project apps/mobile/tsconfig.json",
    "test": "vitest run --config vitest.config.mjs --configLoader native",
    "test:e2e": "node scripts/smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "setup": "node scripts/setup.mjs",
    "convex:deploy": "node scripts/deploy-backend.mjs",
    "mobile": "npm --prefix apps/mobile start",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "convex": "1.45.0",
    "jose": "6.2.10",
    "next": "16.2.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/parser": "8.68.0",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.0.17",
    "playwright-core": "1.56.1",
    "sharp": "0.35.4"
  }
}
